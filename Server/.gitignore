.idea/
**/*.iml
**/*.iws
**/*.ipr
.vscode/
**/.settings/
**/.project
**/.classpath
**/.factorypath

# ===========================
# Spring Boot
# ===========================
*.log
logs/

# ===========================
# Environment
# ===========================
.env
*.env.local

# ===========================
# OS
# ===========================
.DS_Store
Thumbs.db
