# ===========================
# Root .gitignore
# ===========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===========================
# IDE
# ===========================
.vs/
.vscode/
.idea/

# ===========================
# Codely CLI / Tool Config
# ===========================
# 允许 agents/ 和 skills/ 配置同步，忽略大量二进制扩展和临时文件
.codely-cli/extensions/
.codely-cli/auto-saves/
.codely-cli/commands/
.codely-cli/tool-outputs/
.codely-cli/tmp/
.codely-cli/settings.json
.codelyignore
.com-unity-codely.json

# ===========================
# Unity Build
# ===========================
*.apk
*.aab
*.ipa
*.app

# ===========================
# Unity Temp / Library
# ===========================
Client/Library/
Client/Temp/
Client/Obj/
Client/Build/
Client/Builds/
Client/UserSettings/
Client/Logs/
Client/.vs/
Client/.idea/
Client/*.csproj.user

# ===========================
# MimoCode
# ===========================
.mimocode/

# ===========================
# Server (Java / Maven / Spring Boot 多模块)
# ===========================
# 忽略 target 目录下所有构建产物（含 jar，jar 过大不适合进 git）
Server/**/target/*
Server/**/*.jar
Server/.env
Server/**/*.log
Server/logs/
